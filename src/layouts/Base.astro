---
import '@fontsource-variable/source-sans-3/wght.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '../styles/global.css';
import { owner } from '../data/owner';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const home = '/';

const nav = [
  { href: `${home}#leistungen`, label: 'Leistungen' },
  { href: `${home}#baumfaellungen`, label: 'Baumfällungen' },
  { href: `${home}#brennholz`, label: 'Brennholz' },
  { href: `${home}#holzkunst`, label: 'Holzkunst' },
  { href: `${home}#kontakt`, label: 'Kontakt' },
];

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: `${owner.name} – ${owner.business}`,
  url: `https://${owner.domain}/`,
  telephone: '+4978415501',
  email: owner.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: owner.street,
    postalCode: owner.postalCode,
    addressLocality: owner.city,
    addressCountry: 'DE',
  },
});
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#16291f" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>

    <header class="site-header">
      <div class="wrap site-header__row">
        <a class="brand" href="/">
          <span class="brand__name">{owner.name}</span>
          <span class="brand__sub">Haus &amp; Garten</span>
        </a>

        <nav class="nav-desktop" aria-label="Hauptnavigation">
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>

        <a class="btn btn--small header-call" href={owner.phone.href}>
          <span class="visually-hidden">Anrufen: </span>{owner.phone.display}
        </a>

        <details class="nav-mobile">
          <summary aria-label="Menü öffnen oder schließen"><span aria-hidden="true"></span></summary>
          <nav aria-label="Mobile Navigation">
            {nav.map((item) => <a href={item.href}>{item.label}</a>)}
          </nav>
        </details>
      </div>
    </header>

    <main id="inhalt">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer__row">
        <div>
          <p class="site-footer__name">{owner.name}</p>
          <p>{owner.business}</p>
          <address>
            {owner.street}<br />
            {owner.postalCode} {owner.city}
          </address>
        </div>
        <nav aria-label="Rechtliches">
          <a href="/impressum/">Impressum</a>
          <a href="/datenschutz/">Datenschutz</a>
        </nav>
      </div>
    </footer>

    <script src="../scripts/site.ts"></script>
  </body>
</html>
